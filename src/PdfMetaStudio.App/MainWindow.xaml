<Window x:Class="PdfMetaStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PdfMetaStudio.App.Views"
        Title="PDF Meta Studio"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1040" Height="760" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Grid>
        <!-- Главный экран: одна функциональная кнопка -->
        <Grid Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="20">
                <TextBlock Text="Метаданные под контролем" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Text="Выберите PDF, чтобы изменить информацию о документе." Style="{StaticResource Secondary}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,26"/>
                <Button Content="Change meta info" Command="{Binding ChangeMetaInfoCommand}"
                        Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center"
                        Padding="24,12" FontWeight="SemiBold" IsDefault="True"
                        AutomationProperties.Name="Change meta info — выбрать PDF и изменить метаданные"/>
                <StackPanel Visibility="{Binding IsOpening, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <views:LiveTextBlock Text="{Binding OpeningText}" Style="{StaticResource Secondary}" HorizontalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"/>
                    <Button Content="Отменить открытие" Command="{Binding CancelOpeningCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                <views:LiveTextBlock Text="{Binding Error}" Style="{StaticResource Warn}" HorizontalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding Error, Converter={StaticResource NullToVis}}" Margin="0,16,0,0"
                           AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,10">
                <TextBlock Text="Windows · Локальная обработка PDF, без интернета и аккаунта" Style="{StaticResource Secondary}" FontSize="12"/>
            </Border>
        </Grid>
        <!-- Редактор -->
        <ContentControl Content="{Binding Editor}" Focusable="False"/>
    </Grid>
</Window>
