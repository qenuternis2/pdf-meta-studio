<Application x:Class="PdfMetaStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PdfMetaStudio.App.Views"
             xmlns:vm="clr-namespace:PdfMetaStudio.App.ViewModels"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!-- ThemeMode="System": светлая или тёмная тема Fluent по настройке Windows. -->
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <v:InverseBoolConverter x:Key="Not"/>
            <v:InverseBoolToVisibilityConverter x:Key="NotVis"/>
            <v:NullToVisibilityConverter x:Key="NullToVis"/>
            <v:SectionVisibilityConverter x:Key="SectionVis"/>
            <v:ScopeEqualsConverter x:Key="ScopeSelected"/>
            <DataTemplate DataType="{x:Type vm:EditorViewModel}">
                <v:EditorView/>
            </DataTemplate>
            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="Warn" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
