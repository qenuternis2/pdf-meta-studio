<Window x:Class="PdfMetaStudio.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ защищён паролем"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="24" MinWidth="360" MaxWidth="480">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Label Content="_Пароль" Target="{Binding ElementName=Box}" Padding="0,0,0,4"/>
        <PasswordBox x:Name="Box" AutomationProperties.Name="Пароль документа"/>
        <TextBlock Text="Пароль используется только для открытия и записи файла и нигде не сохраняется."
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Открыть" IsDefault="True" MinWidth="96" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="Отмена" IsCancel="True" MinWidth="96"/>
        </StackPanel>
    </StackPanel>
</Window>
