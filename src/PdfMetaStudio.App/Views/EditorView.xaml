<UserControl x:Class="PdfMetaStudio.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PdfMetaStudio.App.Views"
             xmlns:vm="clr-namespace:PdfMetaStudio.App.ViewModels"
             AutomationProperties.Name="Редактор метаданных">
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ReviewCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- Поле аннотации или вложения -->
        <DataTemplate x:Key="ObjectFieldTemplate" DataType="{x:Type vm:ObjectFieldViewModel}">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleDeleteCommand}" Padding="8,4" Margin="6,0,0,0"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding DeleteToolTip}" AutomationProperties.Name="{Binding DeleteToolTip}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding RevertCommand}" Padding="8,4" Margin="6,0,0,0"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"
                            ToolTip="Вернуть исходное значение" AutomationProperties.Name="{Binding Label, StringFormat='Вернуть исходное значение: {0}'}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7A7;"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"/>
                        <TextBlock Text="{Binding Source, StringFormat=' {0}'}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text=" · изменено" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text=" · нет в документе" Style="{StaticResource Secondary}" FontSize="12"
                                   VerticalAlignment="Center" Visibility="{Binding IsAbsent, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                         IsEnabled="{Binding IsDeleted, Converter={StaticResource Not}}"
                         AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Hint}"/>
                <TextBlock Text="Значение удалено. Нажмите кнопку корзины ещё раз, чтобы восстановить." Style="{StaticResource Secondary}"
                           FontSize="12" Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}"/>
                <views:DateEditorView DataContext="{Binding DateEditor}" Visibility="{Binding DataContext.DateEditor, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding Hint, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding Problem}" Style="{StaticResource Warn}" Visibility="{Binding Problem, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Аннотация или вложение -->
        <DataTemplate x:Key="ObjectItemTemplate" DataType="{x:Type vm:ObjectItemViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource ObjectFieldTemplate}" Focusable="False"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Поле простой формы -->
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type vm:FieldViewModel}">
            <StackPanel Margin="0,0,0,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleDeleteCommand}" Padding="8,4" Margin="6,0,0,0"
                            Visibility="{Binding IsAbsent, Converter={StaticResource NotVis}}"
                            ToolTip="{Binding DeleteToolTip}" AutomationProperties.Name="{Binding DeleteToolTip}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding RevertCommand}" Padding="8,4" Margin="6,0,0,0"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"
                            ToolTip="Вернуть исходное значение" AutomationProperties.Name="{Binding Label, StringFormat='Вернуть исходное значение: {0}'}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7A7;"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                        <TextBlock Text=" · изменено" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12"
                                   VerticalAlignment="Center" Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text=" · нет в документе" Style="{StaticResource Secondary}" FontSize="12"
                                   VerticalAlignment="Center" Visibility="{Binding IsAbsent, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Visibility="{Binding IsLocalized, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding LanguageOptions}" Text="{Binding SelectedLanguage, UpdateSourceTrigger=LostFocus}" IsEditable="True" AutomationProperties.Name="Язык поля"/>
                    <WrapPanel><Button Content="Применить языковой вариант XMP" Command="{Binding ApplyLanguageCommand}"/><Button Content="Удалить только этот язык" Command="{Binding DeleteLanguageCommand}"/></WrapPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedItemIndex}" MaxHeight="180" AutomationProperties.Name="Элементы списка"/>
                    <TextBox Text="{Binding ItemText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Автор или элемент списка"/>
                    <WrapPanel><Button Content="Добавить элемент" Command="{Binding AddItemCommand}"/><Button Content="Изменить элемент" Command="{Binding UpdateItemCommand}"/><Button Content="Удалить элемент" Command="{Binding DeleteItemCommand}"/><Button Content="Выше" Command="{Binding MoveItemUpCommand}"/><Button Content="Ниже" Command="{Binding MoveItemDownCommand}"/></WrapPanel>
                </StackPanel>
                <Grid Margin="0,6,0,0">
                    <TextBox x:Name="Input" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             IsEnabled="{Binding IsDeleted, Converter={StaticResource Not}}"
                             Visibility="{Binding IsTextBox, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="{Binding AccessibleName}"
                             AutomationProperties.HelpText="{Binding Hint}"/>
                    <ComboBox ItemsSource="{Binding TrappedValues}" SelectedItem="{Binding Text}"
                              IsEnabled="{Binding IsDeleted, Converter={StaticResource Not}}"
                              Visibility="{Binding IsTrapped, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.Name="{Binding AccessibleName}" MinWidth="200" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Text="Значение удалено. Нажмите кнопку корзины ещё раз, чтобы восстановить." Style="{StaticResource Secondary}"
                           FontSize="12" Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}"/>
                <views:DateEditorView DataContext="{Binding DateEditor}" Visibility="{Binding DataContext.DateEditor, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding Source}" Style="{StaticResource Mono}"/>
                <views:DateEditorView DataContext="{Binding DateEditor}" Visibility="{Binding DataContext.DateEditor, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Secondary}" FontSize="12"
                           Visibility="{Binding Hint, Converter={StaticResource NullToVis}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasSyncChoice, Converter={StaticResource BoolToVis}}">
                    <Label Content="Запись _в:" Target="{Binding ElementName=Sync}" VerticalAlignment="Center" Padding="0,0,8,0"/>
                    <ComboBox x:Name="Sync" ItemsSource="{Binding SyncOptions}" SelectedItem="{Binding SelectedSync}"
                              DisplayMemberPath="Title" MinWidth="160"
                              AutomationProperties.Name="{Binding Label, StringFormat='Куда записывать: {0}'}"/>
                </StackPanel>
                <!-- Конфликт исходных значений -->
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Значения в /Info и XMP различаются" FontWeight="SemiBold"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="/Info" Style="{StaticResource Secondary}" FontSize="12"/>
                                <TextBlock Text="{Binding InfoDisplay}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="XMP" Style="{StaticResource Secondary}" FontSize="12"/>
                                <TextBlock Text="{Binding XmpDisplay}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Взять из /Info" Command="{Binding UseInfoCommand}" Margin="0,0,8,6"/>
                            <Button Content="Взять из XMP" Command="{Binding UseXmpCommand}" Margin="0,0,8,6"/>
                            <Button Content="Оставить разными" Command="{Binding KeepDifferentCommand}" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ConflictState}" Style="{StaticResource Secondary}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding XmpBlocked}" Style="{StaticResource Warn}" Visibility="{Binding XmpBlocked, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding Problem}" Style="{StaticResource Warn}" Visibility="{Binding Problem, Converter={StaticResource NullToVis}}"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Content="Подтвердить потерю точности в /Info" Command="{Binding AcceptLossCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Visibility="{Binding NeedsPrecisionConfirm, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                    <Setter TargetName="Input" Property="AcceptsReturn" Value="True"/>
                    <Setter TargetName="Input" Property="TextWrapping" Value="Wrap"/>
                    <Setter TargetName="Input" Property="MinHeight" Value="72"/>
                    <Setter TargetName="Input" Property="VerticalScrollBarVisibility" Value="Auto"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:TagNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock Text="{Binding Display}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="11" Margin="8,2,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Имя файла -->
        <StackPanel Margin="22,16,22,12">
            <TextBlock Text="{Binding FileName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="12"/><WrapPanel><Button Content="Перезапустить обработчик" Command="{Binding RestartWorkerCommand}"/><Button Content="Перезагрузить файл" Command="{Binding ReloadCommand}"/><Button Content="Ввести пароль владельца" Command="{Binding EnterOwnerPasswordCommand}" Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVis}}"/><Button Content="Разрешить правки подписанной копии" Command="{Binding AllowSignedCopyEditingCommand}" Visibility="{Binding IsSigned, Converter={StaticResource BoolToVis}}"/></WrapPanel>
            <TextBlock Text="{Binding ReadOnlyMessage}" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" Style="{StaticResource Warn}"/>
            <ComboBox ItemsSource="{Binding DocumentScopeOptions}" SelectedItem="{Binding SelectedDocumentScope}" DisplayMemberPath="Title" Visibility="{Binding NeedsScopeChoice, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Область правки XMP документа"/>
            <Expander Header="Размеры страниц (только чтение)"><TextBox Text="{Binding PageDimensions, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></Expander>
            <ItemsControl ItemsSource="{Binding DocumentNotes}" Visibility="{Binding HasDocumentNotes, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Warn}" FontSize="12"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Разделы и поля -->
        <Grid Grid.Row="1" Visibility="{Binding IsReviewing, Converter={StaticResource NotVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" BorderThickness="0"
                     Background="Transparent" Margin="8,0,0,0" AutomationProperties.Name="Разделы метаданных">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Group}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,10,0,4"
                                       Visibility="{Binding Group, Converter={StaticResource NullToVis}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" Margin="0,2,10,0"
/>
                                <TextBlock Text="{Binding Title}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Grid.Column="1" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Border.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=views:EditorView}}"/></Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=views:EditorView}, Converter={StaticResource Not}}"/></Style>
                </Border.Resources>
                <Grid>
                    <!-- Основные -->
                    <ScrollViewer Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource SectionVis}, ConverterParameter=main}"
                                  Padding="26,22" Focusable="False">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                            <TextBlock Text="Основные сведения" FontSize="19" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="Знакомые поля с согласованными значениями в /Info и XMP." Style="{StaticResource Secondary}" Margin="0,2,0,20"/>
                            <ItemsControl ItemsSource="{Binding MainFields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Даты и ПО -->
                    <ScrollViewer Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource SectionVis}, ConverterParameter=dates}"
                                  Padding="26,22" Focusable="False">
                        <StackPanel MaxWidth="820">
                            <TextBlock Text="Даты и программы" FontSize="19" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="Даты сохраняют точность и часовой пояс. Автоматических подстановок нет. Даты файла в Проводнике — отдельные свойства."
                                       Style="{StaticResource Secondary}" Margin="0,2,0,20"/>
                            <ItemsControl ItemsSource="{Binding DateFields}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Все теги -->
                    <Grid Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource SectionVis}, ConverterParameter=all}"
                          DataContext="{Binding Tags}" Margin="20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Все теги документа" FontSize="19" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                        <DockPanel Grid.Row="1" Margin="0,10,0,10">
                            <Button DockPanel.Dock="Right" Content="+ _Добавить тег" Command="{Binding ToggleAddCommand}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     AutomationProperties.Name="Поиск по тегам: имя, пространство имён или значение"
                                     ToolTip="Поиск по имени, пространству имён или значению"/>
                        </DockPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <TreeView x:Name="Tree" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ItemsSource="{Binding Roots}" SelectedItemChanged="OnTreeSelection"
                                      AutomationProperties.Name="Дерево тегов: источник, пространство имён, свойство">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                          AutomationProperties.Name="Разделитель панелей"/>
                            <ScrollViewer Grid.Column="2" Focusable="False" Padding="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding Selected.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Selected.Subtitle}" Style="{StaticResource Secondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedHint}" TextWrapping="Wrap" Style="{StaticResource Secondary}"/>
                                        <TextBlock Text="Точный путь" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBox Text="{Binding Selected.ExactPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="11" AutomationProperties.Name="Точный путь тега"/>
                                        <Label Content="_Значение" Target="{Binding ElementName=TagValue}" Padding="0,10,0,4"/>
                                        <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Title"
                                                  Visibility="{Binding HasScopeChoice, Converter={StaticResource BoolToVis}}"
                                                  AutomationProperties.Name="Область правки выбранного тега"/>
                                        <ComboBox ItemsSource="{Binding ValueTypes}" SelectedItem="{Binding SelectedValueType}" DisplayMemberPath="Title"
                                                  AutomationProperties.Name="Тип ввода значения" IsEnabled="{Binding Selected.IsEditable}"/>
                                        <TextBox x:Name="TagValue" Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                 Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVis}}"
                                                 TextWrapping="Wrap" MinHeight="60" IsEnabled="{Binding Selected.IsEditable}"
                                                 AutomationProperties.Name="Значение выбранного тега"/>
                                        <ComboBox ItemsSource="{Binding BooleanValues}" SelectedItem="{Binding EditValue}"
                                                  Visibility="{Binding IsBooleanInput, Converter={StaticResource BoolToVis}}"
                                                  IsEnabled="{Binding Selected.IsEditable}" AutomationProperties.Name="Логическое значение"/>
                                        <views:DateEditorView DataContext="{Binding DateEditor}" Visibility="{Binding DataContext.IsDateInput, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVis}}"/>
                                        <Expander Header="Элементы массива" Visibility="{Binding CanManageArray, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <ComboBox ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding ItemType}" DisplayMemberPath="Title" AutomationProperties.Name="Тип нового элемента"/>
                                                <TextBox Text="{Binding ItemValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Значение нового элемента"/>
                                                <WrapPanel><Button Content="Добавить в конец" Command="{Binding AppendItemCommand}"/><Button Content="Вставить перед выбранным" Command="{Binding InsertItemCommand}"/></WrapPanel>
                                                <WrapPanel Visibility="{Binding CanMoveItem, Converter={StaticResource BoolToVis}}"><Button Content="Выше" Command="{Binding MoveItemUpCommand}"/><Button Content="Ниже" Command="{Binding MoveItemDownCommand}"/></WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Переименовать узел" Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}">
                                            <StackPanel><TextBox Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Новое имя узла"/><TextBox Text="{Binding RenameUri, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Пространство имён нового имени"/><Button Content="Переименовать" Command="{Binding RenameCommand}"/></StackPanel>
                                        </Expander>
                                        <Expander Header="Диагностика PDF: тип и исходные байты"><TextBox Text="{Binding SelectedDiagnostic, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="300" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Диагностика выбранного PDF-значения"/></Expander>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="_Применить" Command="{Binding ApplyCommand}" Margin="0,0,8,6"/>
                                            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="0,0,8,6"/>
                                            <Button Content="Восстановить" Command="{Binding RestoreCommand}" Margin="0,0,8,6"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Warn}" Visibility="{Binding Message, Converter={StaticResource NullToVis}}"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                    <!-- Добавление тега -->
                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Новый тег" FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedStream}" DisplayMemberPath="Title"
                                                      AutomationProperties.Name="Область нового тега" Margin="0,8,0,0"/>
                                            <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Title"
                                                      Visibility="{Binding HasScopeChoice, Converter={StaticResource BoolToVis}}"
                                                      AutomationProperties.Name="Область правки нового тега" Margin="0,8,0,0"/>
                                            <CheckBox Content="Добавить к выбранной структуре или узлу" IsChecked="{Binding AddToSelected}" Margin="0,8,0,0"/>
                                            <Label Content="_Тип" Target="{Binding ElementName=NewType}" Padding="0,8,0,4"/>
                                            <ComboBox x:Name="NewType" ItemsSource="{Binding AddTypes}" SelectedItem="{Binding NewType}" DisplayMemberPath="Title"/>
                                            <Label Content="_Имя (без префикса; для /Info — имя ключа)" Target="{Binding ElementName=NewName}" Padding="0,8,0,4"/>
                                            <TextBox x:Name="NewName" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Label Content="Пространство имён (_URI)" Target="{Binding ElementName=NewUri}" Padding="0,8,0,4"/>
                                            <TextBox x:Name="NewUri" Text="{Binding NewUri, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Label Content="Желаемый _префикс (необязательно)" Target="{Binding ElementName=NewPrefix}" Padding="0,8,0,4"/>
                                            <TextBox x:Name="NewPrefix" Text="{Binding NewPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Label Content="З_начение (списки — по строкам; дата — ISO 8601; логическое — True/False)" Target="{Binding ElementName=NewValue}" Padding="0,8,0,4"/>
                                            <TextBox x:Name="NewValue" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                                            <Label Content="Языковая _метка (для языкового варианта)" Padding="0,8,0,4"/>
                                            <TextBox Text="{Binding NewLanguage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Язык нового варианта"/>
                                            <TextBlock Text="{Binding AddError}" Style="{StaticResource Warn}" Visibility="{Binding AddError, Converter={StaticResource NullToVis}}"
                                                       AutomationProperties.LiveSetting="Assertive"/>
                                            <Button Content="Добавить" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Style="{DynamicResource AccentButtonStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <!-- Исходный XMP -->
                        <Expander Grid.Row="3" Header="Исходный XMP выбранного объекта (XML)" Margin="0,12,0,0">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedStream}" DisplayMemberPath="Title"
                                          AutomationProperties.Name="Объект для редактирования XMP"/>
                                <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Title"
                                          Visibility="{Binding HasScopeChoice, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.Name="Область правки выбранного потока"/>
                                <Button IsEnabled="True" Content="Экспортировать исходный пакет без изменения байтов…" Command="{Binding ExportOriginalPacketCommand}" HorizontalAlignment="Left"/>
                                <Expander Header="Исходные байты не-UTF-8 пакета (Base64)" Visibility="{Binding RawPacketBase64, Converter={StaticResource NullToVis}}"><TextBox Text="{Binding RawPacketBase64, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"/></Expander>
                                <TextBlock Text="{Binding DocumentXmpProblem}" Style="{StaticResource Warn}"
                                           Visibility="{Binding DocumentXmpProblem, Converter={StaticResource NullToVis}}"/>
                                <TextBox Text="{Binding RawXml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="220" Margin="0,6,0,0"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Исходный XML пакета XMP"/>
                                <Button Content="Применить XML" Command="{Binding ApplyRawXmlCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <Button Content="Отменить ввод XML" Command="{Binding ResetXmlCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                    </Grid>

                    <!-- Объекты PDF -->
                    <ScrollViewer Visibility="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource SectionVis}, ConverterParameter=objects}"
                                  Padding="26,22" Focusable="False" DataContext="{Binding Objects}">
                        <StackPanel MaxWidth="820">
                            <TextBlock Text="Метаданные объектов" FontSize="19" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="У каждого объекта — собственные поля. Правки не распространяются на весь PDF." Style="{StaticResource Secondary}" Margin="0,2,0,6"/>
                            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,16"/>
                            <TextBlock Text="Отдельных потоков XMP у страниц, изображений и других объектов нет." Style="{StaticResource Secondary}"
                                       Visibility="{Binding HasStreams, Converter={StaticResource NotVis}}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Streams}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ObjectStreamViewModel}">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="12"/>
                                                <TextBlock Text="{Binding Problem}" Style="{StaticResource Warn}" Visibility="{Binding Problem, Converter={StaticResource NullToVis}}"/>
                                                <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Title"
                                                          Margin="0,8,0,0" Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}"
                                                          AutomationProperties.Name="Область правки общего потока"/>
                                                <ItemsControl ItemsSource="{Binding Values}" Margin="0,8,0,0" IsEnabled="{Binding Editable}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" Margin="0,0,0,3"/>
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                                         AutomationProperties.Name="{Binding Path}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Warn}" Visibility="{Binding Message, Converter={StaticResource NullToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Аннотации" FontWeight="SemiBold" Margin="0,12,0,2" AutomationProperties.HeadingLevel="Level3"
                                       Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Автор, тема и даты комментариев. Текст самих комментариев не изменяется." Style="{StaticResource Secondary}"
                                       FontSize="12" Margin="0,0,0,8" Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Annotations}" ItemTemplate="{StaticResource ObjectItemTemplate}" Focusable="False"/>
                            <TextBlock Text="Вложения" FontWeight="SemiBold" Margin="0,12,0,2" AutomationProperties.HeadingLevel="Level3"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Имя, описание и даты вложенных файлов. Содержимое файлов не изменяется." Style="{StaticResource Secondary}"
                                       FontSize="12" Margin="0,0,0,8" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource ObjectItemTemplate}" Focusable="False"/>
                            <TextBlock Text="Частные контейнеры /PieceInfo" FontWeight="SemiBold" Margin="0,12,0,6"
                                       Visibility="{Binding HasPieceInfo, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding PieceInfo}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource ObjectFieldTemplate}"/>
                                            <Expander Header="Типы и исходные байты"><TextBox Text="{Binding Diagnostic, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto"/></Expander>
                                            <Button IsEnabled="True" Content="Экспортировать частные данные…" Command="{Binding ExportCommand}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Проверка «Было → Станет» -->
        <Border Grid.Row="1" Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <ScrollViewer Padding="26,22" Focusable="False">
                <StackPanel MaxWidth="900">
                    <TextBlock Text="Проверка изменений" FontSize="19" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="Сравните значения перед сохранением. Исходный файл не изменится, пока вы не выберете «Заменить оригинал…»."
                               Style="{StaticResource Secondary}" Margin="0,2,0,14"/>
                    <ItemsControl ItemsSource="{Binding ReviewIssues}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Warn}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding NeedsScopeChoice, Converter={StaticResource BoolToVis}}" Margin="0,8,0,8">
                        <TextBlock Text="XMP документа общий с другими объектами. Как его менять?" FontWeight="SemiBold"/>
                        <RadioButton Content="Изменить для всех владельцев" GroupName="DocScope" Margin="0,6,0,0" Checked="OnScopeAll"/>
                        <RadioButton Content="Отделить копию только для документа" GroupName="DocScope" Checked="OnScopeDetach"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ReviewRows}" Focusable="False" AutomationProperties.Name="Список изменений">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,10">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding Path, Mode=OneWay}"/>
                                        </TextBlock>
                                        <views:DateEditorView DataContext="{Binding DateEditor}" Visibility="{Binding DataContext.DateEditor, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding Source}" Style="{StaticResource Mono}"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Warn}" FontSize="12"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Было" Style="{StaticResource Secondary}" FontSize="12"/>
                                                <TextBlock Text="{Binding Before}" TextWrapping="Wrap" Style="{StaticResource Secondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Станет" Style="{StaticResource Secondary}" FontSize="12"/>
                                                <TextBlock Text="{Binding After}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ReviewNotes}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Secondary}" FontSize="12"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Внешний валидатор профиля (необязательно)">
                        <StackPanel><TextBlock Text="После сохранения локальный veraPDF проверит записанный файл. Проверка PDF/A или PDF/UA не подтверждает PDF/X; статус каждого профиля оценивается отдельно." TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ValidatorPath}" TextWrapping="Wrap"/><WrapPanel><Button Content="Выбрать veraPDF CLI…" Command="{Binding SelectValidatorCommand}"/><Button Content="Отключить валидатор" Command="{Binding ClearValidatorCommand}"/></WrapPanel>
                        </StackPanel>
                    </Expander>
                    <CheckBox Content="Обновить дату изменения (/ModDate, xmp:ModifyDate, xmp:MetadataDate)" IsChecked="{Binding UpdateModifyDate}" Margin="0,14,0,0"/>
                    <CheckBox Content="Я понимаю, что подпись в копии станет недействительной" IsChecked="{Binding SignedAcknowledged}" Margin="0,8,0,0"
                              Visibility="{Binding IsSigned, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,12,0,0">
                        <Run Text="Имя копии по умолчанию: "/><Run Text="{Binding CopyName, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Действия -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,12">
            <StackPanel>
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Отмена" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding BusyPercent}" Maximum="100" Height="4" Margin="0,6,0,0"
                                 AutomationProperties.Name="Ход выполнения"/>
                </StackPanel>
                <!-- Режим правки -->
                <DockPanel Visibility="{Binding IsReviewing, Converter={StaticResource NotVis}}" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" VerticalAlignment="Center" Style="{StaticResource Secondary}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button DockPanel.Dock="Right" Content="Проверить и сохранить" Command="{Binding ReviewCommand}"
                            Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" ToolTip="Ctrl+S"/>
                    <Button DockPanel.Dock="Right" Content="Закрыть" Command="{Binding CloseCommand}" Margin="8,0,0,0" ToolTip="Ctrl+W"/>
                    <Button DockPanel.Dock="Right" Content="Повторить" Command="{Binding RedoCommand}" Margin="8,0,0,0" ToolTip="Ctrl+Y"/>
                    <Button DockPanel.Dock="Right" Content="Отменить" Command="{Binding UndoCommand}" Margin="8,0,0,0" ToolTip="Отменить последнюю правку"/>
                    <Button DockPanel.Dock="Right" Content="Сбросить все" Command="{Binding RevertAllCommand}" Margin="8,0,0,0"/>
                </DockPanel>
                <!-- Режим проверки -->
                <DockPanel Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Оригинал останется без изменений" VerticalAlignment="Center" Style="{StaticResource Secondary}"/>
                    <Button DockPanel.Dock="Right" Content="Сохранить копию…" Command="{Binding SaveCopyCommand}"
                            Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Дополнительно ▾" Margin="8,0,0,0" Click="OnSaveMenu">
                        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Заменить оригинал…" Command="{Binding ReplaceCommand}"/></ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="К редактированию" Command="{Binding BackToEditCommand}" Margin="8,0,0,0" IsCancel="True"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
