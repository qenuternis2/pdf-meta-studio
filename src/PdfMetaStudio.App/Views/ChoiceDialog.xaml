<Window x:Class="PdfMetaStudio.App.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="24" MinWidth="380" MaxWidth="560">
        <TextBlock x:Name="Message" TextWrapping="Wrap"/>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"/>
    </StackPanel>
</Window>
